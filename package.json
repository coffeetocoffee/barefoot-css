{
  "name": "barefoot-css",
  "version": "4.8.0",
  "description": "A bare-bones, themeable, JS-free CSS framework. No boots, no baggage.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.css",
  "style": "dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./full.css": "./dist/full.css",
    "./utilities.css": "./dist/utilities.css",
    "./tokens.json": "./dist/tokens.json",
    "./components/*": "./dist/components/*",
    "./themes/*": "./dist/themes/*",
    "./js/*": "./dist/js/*",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "*.js"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "size": "node build/size.mjs",
    "docs:size": "node build/readme-size.mjs",
    "docs:tokens": "node build/token-docs.mjs",
    "migrate:v3": "node build/codemod-3.mjs",
    "migrate:v4": "node build/codemod-4.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "node build/serve.mjs",
    "check": "npm run build && npm run size && npm run docs:size && npm run docs:tokens && npm run lint:css",
    "test": "playwright test --project=chromium",
    "test:a11y": "playwright test --project=chromium tests/a11y.spec.js",
    "test:js": "playwright test --project=chromium tests/js.spec.js",
    "test:css": "playwright test --project=chromium tests/css.spec.js",
    "test:visual": "playwright test --project=chromium tests/visual.spec.js",
    "test:visual:update": "playwright test --project=chromium tests/visual.spec.js --update-snapshots",
    "test:ff": "playwright test --project=firefox tests/css.spec.js tests/js.spec.js tests/visual.spec.js",
    "test:webkit": "playwright test --project=webkit tests/css.spec.js tests/js.spec.js tests/visual.spec.js",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffeetocoffee/barefoot-css.git"
  },
  "homepage": "https://github.com/coffeetocoffee/barefoot-css",
  "bugs": {
    "url": "https://github.com/coffeetocoffee/barefoot-css/issues"
  },
  "keywords": [
    "css",
    "framework",
    "design-system",
    "themeable",
    "accessibility",
    "js-free",
    "cascade-layers",
    "container-queries",
    "view-transitions"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "lightningcss": "^1.29.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
